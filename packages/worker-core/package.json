{
  "version": "0.0.0",
  "name": "@acme/worker-core",
  "private": true,
  "type": "module",
  "exports": {
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "default": "./dist/workflow/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "bun run rm -rf dist *.tsbuildinfo .turbo node_modules",
    "dev": "tsc -w -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@acme/db": "workspace:*",
    "@mastra/core": "0.23.1",
    "drizzle-orm": "0.44.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@acme/typescript": "workspace:*",
    "@types/node": "24.9.1"
  }
}
